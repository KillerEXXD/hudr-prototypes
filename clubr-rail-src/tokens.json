{
  "label": "Rail",
  "tagline": "Social-first — your crews, not your games",
  "kind": "dark",
  "swatch": { "bg": "#17120F", "accent": "#FF7A59", "text": "#F6F1EC" },
  "vars": {
    "--color-bg-primary": "#17120F", "--color-bg-secondary": "#0F0B09", "--color-bg-card": "#211915",
    "--color-bg-surface": "#2A201B", "--color-bg-elevated": "#352822", "--color-border": "#3A2C24", "--color-border-light": "#4A382E",
    "--color-text-primary": "#F6F1EC", "--color-text-secondary": "#C9B8AC", "--color-text-muted": "#8C7A6E",
    "--color-accent-blue": "#5AA9E6", "--color-accent-amber": "#FFB155", "--color-accent-emerald": "#4FCB8B",
    "--color-accent-red": "#FF7A59", "--color-accent-purple": "#C08BE6", "--color-accent-gold": "#FF7A59",
    "--font-family-sans": "'Plus Jakarta Sans', system-ui, sans-serif",
    "--font-family-mono": "'IBM Plex Mono', ui-monospace, monospace",
    "--font-family-display": "'Plus Jakarta Sans', system-ui, sans-serif"
  },
  "spacing_scale_px": [0,4,8,12,16,20,24,32,40,48,64,80,96,128],
  "type_scale": { "base": "1rem", "lg": "1.125rem", "xl": "1.25rem" },
  "radii": { "DEFAULT": "0.5rem", "lg": "0.75rem", "xl": "1.25rem", "full": "9999px" },
  "shadows": { "DEFAULT": "0 1px 2px 0 rgb(0 0 0 / 0.4)", "md": "0 6px 20px -14px rgb(0 0 0 / 0.7)" }
}
