{
  "label": "Daylight",
  "tagline": "Warm paper, calendar-first — the only light skin",
  "kind": "light",
  "swatch": { "bg": "#F7F3EA", "accent": "#2F6F4F", "text": "#1E2A24" },
  "vars": {
    "--color-bg-primary": "#F7F3EA", "--color-bg-secondary": "#FBF8F1", "--color-bg-card": "#FFFFFF",
    "--color-bg-surface": "#F0EADC", "--color-bg-elevated": "#EAE3D2", "--color-border": "#E4DBC8", "--color-border-light": "#D6CBB2",
    "--color-text-primary": "#1E2A24", "--color-text-secondary": "#52605A", "--color-text-muted": "#8A938C",
    "--color-accent-blue": "#2F6F4F", "--color-accent-amber": "#C77D3A", "--color-accent-emerald": "#2F6F4F",
    "--color-accent-red": "#C0503C", "--color-accent-purple": "#7A5AA8", "--color-accent-gold": "#C77D3A",
    "--font-family-sans": "'Inter', system-ui, sans-serif",
    "--font-family-mono": "'IBM Plex Mono', ui-monospace, monospace",
    "--font-family-display": "'Fraunces', Georgia, serif"
  },
  "spacing_scale_px": [0,4,8,12,16,20,24,32,40,48,64,80,96,128],
  "type_scale": { "base": "1rem", "lg": "1.125rem", "xl": "1.25rem" },
  "radii": { "DEFAULT": "0.75rem", "lg": "1rem", "xl": "1.25rem", "2xl": "1.25rem", "full": "9999px" },
  "shadows": {
    "DEFAULT": "0 2px 10px -6px rgba(30,42,36,0.12)",
    "md": "0 8px 24px -10px rgba(30,42,36,0.18)",
    "lg": "0 16px 40px -16px rgba(30,42,36,0.22)"
  }
}
