{
  "label": "Golden",
  "tagline": "Premium poker-luxe — the ClubrGo reference design, as an installable PWA",
  "kind": "dark",
  "swatch": { "bg": "#0B0F17", "accent": "#E9C46A", "text": "#F3F6F2" },
  "vars": {
    "--color-bg-primary": "#0B0F17", "--color-bg-secondary": "#070A11", "--color-bg-card": "#121826",
    "--color-bg-surface": "#1A2234", "--color-bg-elevated": "#222C42", "--color-border": "#243049", "--color-border-light": "#33425F",
    "--color-text-primary": "#F3F6F2", "--color-text-secondary": "#A9B6CC", "--color-text-muted": "#6B7A93",
    "--color-accent-blue": "#4A90E2", "--color-accent-amber": "#E9C46A", "--color-accent-emerald": "#36C98B",
    "--color-accent-red": "#E5604F", "--color-accent-purple": "#A98BE6", "--color-accent-gold": "#E9C46A",
    "--font-family-sans": "'Inter', system-ui, sans-serif",
    "--font-family-mono": "'IBM Plex Mono', ui-monospace, monospace",
    "--font-family-display": "'Space Grotesk', 'Inter', system-ui, sans-serif"
  },
  "spacing_scale_px": [0,4,8,12,16,20,24,32,40,48,64,80,96,128],
  "radii": { "DEFAULT": "0.5rem", "lg": "0.75rem", "xl": "1rem", "2xl": "1.125rem", "full": "9999px" },
  "shadows": { "DEFAULT": "0 1px 2px 0 rgb(0 0 0 / 0.4)", "md": "0 6px 20px -14px rgb(0 0 0 / 0.7)" }
}
