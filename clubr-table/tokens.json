{
  "label": "Table",
  "tagline": "In-session — big-touch, glanceable from across the felt",
  "kind": "dark",
  "swatch": { "bg": "#06140E", "accent": "#34E89E", "text": "#FFFFFF" },
  "vars": {
    "--color-bg-primary": "#06140E", "--color-bg-secondary": "#030B07", "--color-bg-card": "#0C2218",
    "--color-bg-surface": "#123022", "--color-bg-elevated": "#1A4030", "--color-border": "#1B3A2A", "--color-border-light": "#27523C",
    "--color-text-primary": "#FFFFFF", "--color-text-secondary": "#B7D6C6", "--color-text-muted": "#6FA088",
    "--color-accent-blue": "#54C7FF", "--color-accent-amber": "#FFC23D", "--color-accent-emerald": "#34E89E",
    "--color-accent-red": "#FF5C6C", "--color-accent-purple": "#B98BFF", "--color-accent-gold": "#34E89E",
    "--font-family-sans": "'Space Grotesk', system-ui, sans-serif",
    "--font-family-mono": "'JetBrains Mono', ui-monospace, monospace",
    "--font-family-display": "'Space Grotesk', system-ui, sans-serif"
  },
  "spacing_scale_px": [0,4,8,12,16,20,24,32,40,48,64,80,96,128],
  "type_scale": { "base": "1rem", "lg": "1.125rem", "xl": "1.25rem" },
  "radii": { "DEFAULT": "0.75rem", "lg": "1rem", "xl": "1.5rem", "2xl": "1.75rem", "full": "9999px" },
  "shadows": { "DEFAULT": "0 1px 2px 0 rgb(0 0 0 / 0.4)", "md": "0 8px 28px -10px rgba(52,232,158,0.4)" }
}
