{
  "label": "Ledger",
  "tagline": "Grinder stats cockpit — mono numerals, one sharp accent",
  "kind": "dark",
  "swatch": { "bg": "#0C0F12", "accent": "#B6F36B", "text": "#E9EEF2" },
  "vars": {
    "--color-bg-primary": "#0C0F12", "--color-bg-secondary": "#080A0C", "--color-bg-card": "#13181D",
    "--color-bg-surface": "#1A2128", "--color-bg-elevated": "#222B33", "--color-border": "#222A31", "--color-border-light": "#303A43",
    "--color-text-primary": "#E9EEF2", "--color-text-secondary": "#9DAAB5", "--color-text-muted": "#5F6E79",
    "--color-accent-blue": "#5AA9E6", "--color-accent-amber": "#E9B44C", "--color-accent-emerald": "#5BD08A",
    "--color-accent-red": "#F0664F", "--color-accent-purple": "#9D8BE6", "--color-accent-gold": "#B6F36B",
    "--font-family-sans": "'IBM Plex Sans', system-ui, sans-serif",
    "--font-family-mono": "'IBM Plex Mono', ui-monospace, monospace",
    "--font-family-display": "'IBM Plex Sans', system-ui, sans-serif"
  },
  "spacing_scale_px": [0,4,8,12,16,20,24,32,40,48,64,80,96,128],
  "type_scale": { "base": "1rem", "lg": "1.125rem", "xl": "1.25rem" },
  "radii": { "DEFAULT": "0.5rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
  "shadows": { "DEFAULT": "0 1px 2px 0 rgb(0 0 0 / 0.4)", "md": "0 6px 20px -14px rgb(0 0 0 / 0.7)" }
}
